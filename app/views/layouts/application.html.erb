<!DOCTYPE html>
<html>
  <head>
    <title>MealSearchApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- CSS from Sprockets -->
    <link rel="stylesheet" href="/assets/application.css" data-turbo-track="reload">
    
    <!-- JavaScript from Importmap -->
    <%= javascript_importmap_tags %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <style>
      .meal-card {
        transition: transform 0.2s;
        cursor: pointer;
      }
      .meal-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Meal Search App", root_path, class: "navbar-brand" %>
        
        <div class="ms-auto d-flex gap-2">
          <button type="button" id="surpriseMeBtn" class="btn btn-outline-warning">
            <i class="bi bi-stars"></i> Surprise Me!
          </button>
          
          <%= link_to shopping_list_index_path, class: "btn btn-outline-light position-relative" do %>
            <i class="bi bi-cart"></i> Shopping List
            <span id="shopping_list_count" 
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" 
                  style="display: none;">
              0
            </span>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container">
      <%= yield %>
    </div>
    
    <!-- Modal -->
    <div class="modal fade" id="mealModal" tabindex="-1" data-controller="modal">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Meal Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <turbo-frame id="modal_content">
              <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
            </turbo-frame>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div id="notifications" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11"></div>

    <script>
      document.addEventListener('turbo:before-stream-render', (event) => {
        console.log('Turbo stream received:', event);
      });
      
      document.addEventListener('turbo:stream-render', (event) => {
        console.log('Turbo stream rendered:', event);
      });
    </script>

    <script>
      document.addEventListener('turbo:load', () => {
        console.log('Turbo loaded')
        console.log('StimulusApp:', window.StimulusApp)
        console.log('Controllers:', window.StimulusApp?.controllers.map(c => c.context.identifier))
        
        // Check shopping list controller
        const controller = window.StimulusApp?.controllers.find(c => c.context.identifier === 'shopping-list')
        console.log('Shopping list controller found:', !!controller)
        
        if (controller) {
          console.log('Shopping list items:', controller.shoppingList?.length)
        }
      })
    </script>    

    <!-- Hidden elements for Turbo Stream updates -->
    <div id="notifications" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11"></div>
    <span id="shopping_list_count" style="display: none;">0</span>    
  </body>
</html>