<div class="row mb-4">
  <div class="col-md-8 mx-auto">
    <div class="card">
      <div class="card-body">
        <h1 class="card-title text-center mb-4">Search for Meals</h1>
        
        <%= form_tag meals_path, method: :get, 
            data: { turbo_frame: "search-results", turbo_action: "advance" },
            id: "search-form" do %>
          <div class="input-group">
            <%= text_field_tag :search, params[:search], 
                class: "form-control form-control-lg", 
                placeholder: "Enter a meal name...",
                autofocus: true %>
            <%= submit_tag "Search", class: "btn btn-primary btn-lg", name: nil %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= turbo_frame_tag "search-results" do %>
  <%= render "results", meals: @meals, search_term: @search_term %>
<% end %>

<!-- Surprise Me button handler -->
<script>
  document.getElementById('surpriseMeBtn')?.addEventListener('click', function() {
    // Find the modal controller and call openRandom
    const modalElement = document.getElementById('mealModal');
    const controller = modalElement?.__stimulusController;
    if (controller && controller.openRandom) {
      controller.openRandom(new Event('click'));
    }
  });
</script>