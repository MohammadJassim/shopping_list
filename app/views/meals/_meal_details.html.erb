<div data-controller="shopping-list" data-recipe-id="<%= meal[:id] %>" data-recipe-name="<%= meal[:name] %>">

  <div class="row" data-recipe-id="<%= meal[:id] %>" data-recipe-name="<%= meal[:name] %>">
    <div class="col-md-5">
      <img src="<%= meal[:thumbnail] %>" class="img-fluid rounded" alt="<%= meal[:name] %>">
    </div>
    <div class="col-md-7">
      <h4><%= meal[:name] %></h4>
      <p><strong>Category:</strong> <%= meal[:category] || 'N/A' %></p>
      <p><strong>Area:</strong> <%= meal[:area] || 'N/A' %></p>
      <% if meal[:tags].present? %>
        <p><strong>Tags:</strong> <%= meal[:tags] %></p>
      <% end %>
      
      <h5 class="mt-3">Ingredients:</h5>
      <ul class="ingredients-list list-unstyled">
        <% meal[:ingredients].each do |ing| %>
          <li class="mb-2 p-2 bg-light rounded d-flex justify-content-between align-items-center">
            <span><%= ing[:measure] %> <%= ing[:ingredient] %></span>
            <button type="button" 
                    class="btn btn-sm btn-outline-success add-ingredient-btn"
                    data-action="click->shopping-list#addIngredients"
                    data-ingredients='[{"ingredient":"<%= ing[:ingredient] %>","measure":"<%= ing[:measure] %>"}]'
                    data-recipe-name="<%= meal[:name] %>">
              <i class="bi bi-cart-plus"></i> Add
            </button>
          </li>
        <% end %>
      </ul>
      
      <button class="btn btn-success mt-3 w-100 add-all-ingredients-btn"
              data-action="click->shopping-list#addIngredients"
              data-ingredients='<%= meal[:ingredients].to_json %>'
              data-recipe-name="<%= meal[:name] %>">
        <i class="bi bi-cart-plus"></i> Add All Ingredients to Shopping List
      </button>
    </div>    
  </div>
  <div class="row mt-3">
    <div class="col-12">
      <h5>Instructions:</h5>
      <p><%= meal[:instructions] || 'No instructions available' %></p>
      <% if meal[:youtube].present? %>
        <a href="<%= meal[:youtube] %>" target="_blank" class="btn btn-danger mt-2">Watch on YouTube</a>
      <% end %>
      <% if meal[:source].present? %>
        <a href="<%= meal[:source] %>" target="_blank" class="btn btn-secondary mt-2 ms-2">View Source</a>
      <% end %>
    </div>
  </div>

</div>