<!DOCTYPE html>
<html>
  <head>
    <title>ShoppingListApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <style>
      .meal-card {
        transition: transform 0.2s;
        cursor: pointer;
      }
      .meal-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Meal Search App", root_path, class: "navbar-brand" %>
      </div>
    </nav>

    <div class="container">
      <%= yield %>
    </div>
    
    <script>
      // Pure JavaScript for modals
      document.addEventListener('click', function(e) {
        const button = e.target.closest('.view-more-btn');
        if (button) {
          e.preventDefault();
          const mealId = button.getAttribute('data-meal-id');
          console.log("View More clicked for meal:", mealId);
          
          const modalElement = document.getElementById('mealModal');
          const modalBody = modalElement.querySelector('.modal-body');
          
          // Show loading
          modalBody.innerHTML = `
            <div class="text-center py-5">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2">Loading meal details...</p>
            </div>
          `;
          
          // Fetch meal details
          fetch(`/meals/${mealId}`)
            .then(response => response.text())
            .then(html => {
              modalBody.innerHTML = html;
              // Show modal
              const modal = new bootstrap.Modal(modalElement);
              modal.show();
            })
            .catch(error => {
              console.error("Error loading meal:", error);
              modalBody.innerHTML = `
                <div class="alert alert-danger">
                  Failed to load meal details. Please try again.
                </div>
              `;
            });
        }
      });
    </script>
  </body>
</html>